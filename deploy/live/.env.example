# Copy to .env on the server (chmod 600 .env) and fill in. Never commit the real file.

# The public IPv4 address of the VPS: what the game client is told to connect to.
PUBLIC_IP=203.0.113.10

# The image the deploy workflow builds and pushes (the workflow sets OPENMU_IMAGE itself for each deploy).
OPENMU_IMAGE=ghcr.io/rauseklis/openmu:latest

# The database. Use a long random password: openssl rand -base64 24
DB_ADMIN_USER=postgres
DB_ADMIN_PW=change-me
DB_NAME=openmu

# The admin panel user created on the first start. The panel is only reachable through an SSH tunnel.
OPENMU_ADMIN_USER=admin
OPENMU_ADMIN_PASSWORD=change-me-too
